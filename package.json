{
  "name": "syncura",
  "private": true,
  "version": "2.6.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "control": "tsx server/control.ts",
    "test": "npm run typecheck && npm run pretest && npm run test:e2ee && npm run test:api && npm run test:realtime && npm run test:browser && npm run test:history && npm run test:native && npm run test:pair",
    "pretest": "npm run build && bash scripts/serve.sh --fresh",
    "test:e2ee": "tsx scripts/e2ee-test.ts",
    "test:api": "tsx scripts/api-test.ts",
    "test:storage": "tsx scripts/storage-test.ts",
    "test:realtime": "tsx scripts/realtime-test.ts",
    "test:browser": "tsx scripts/browser-test.ts",
    "test:history": "tsx scripts/history-view-test.ts",
    "test:native": "bash scripts/test-native.sh && bash scripts/serve.sh --fresh",
    "test:pair": "tsx scripts/pair-test.ts",
    "serve:detached": "bash scripts/serve.sh",
    "build:android": "npm run build && cap sync android && cd android && ./gradlew --no-daemon assembleDebug",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.2",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@tanstack/react-query": "^5.66.0",
    "express": "^5.1.0",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "ws": "^8.22.0"
  }
}

